{
  "name": "guntaneticaret",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "turbo dev",
    "build": "node scripts/hostinger-next.mjs build",
    "build:all": "turbo build",
    "start": "node scripts/hostinger-next.mjs start",
    "lint": "turbo lint",
    "test": "turbo test",
    "test:e2e": "playwright test",
    "db:generate": "pnpm --filter @guntan/db generate",
    "db:migrate": "pnpm --filter @guntan/db migrate",
    "db:seed": "pnpm --filter @guntan/db seed",
    "db:ensure-admin": "pnpm --filter @guntan/db ensure-admin",
    "db:sync-catalog": "pnpm --filter @guntan/db sync-catalog",
    "db:sync-tenants": "pnpm --filter @guntan/db sync-tenants",
    "import:xml": "pnpm --filter @guntan/import guntan-xml",
    "import:basbug": "pnpm --filter @guntan/import basbug-json",
    "import:dedupe": "pnpm --filter @guntan/import dedupe-cheapest",
    "import:price-tiers": "pnpm --filter @guntan/import price-tiers",
    "db:studio": "pnpm --filter @guntan/db studio",
    "worker": "pnpm --filter @guntan/worker dev"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.1",
    "@types/node": "^22.13.10",
    "turbo": "^2.5.4",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  }
}
