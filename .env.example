DATABASE_URL=mysql://guntan:guntan@localhost:3306/guntan
# Hostinger canlı (şifredeki özel karakterleri URL-encode et: &→%26 +→%2B)
# DATABASE_URL=mysql://USER:PASS@auth-db2116.hstgr.io:3306/DBNAME
# Aynı sunucudaysa host=localhost daha hızlıdır.
REDIS_URL=redis://localhost:6379
MEILI_HOST=http://localhost:7700
MEILI_MASTER_KEY=dev_meili_master_key_change_me
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=guntan-media
S3_ACCESS_KEY=minio
S3_SECRET=minio-secret
S3_PUBLIC_URL=http://localhost:9000/guntan-media
BETTER_AUTH_SECRET=change-me-to-a-32-char-secret-key!!
ADMIN_COOKIE_DOMAIN=localhost
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=siparis@guntanotoyedekparca.com
SENTRY_DSN=
LOG_LEVEL=info
DEFAULT_TENANT_SLUG=guntan
STOREFRONT_URL=http://guntan.localhost:3000
ADMIN_URL=http://localhost:3001

# Tedarikçi senkronu (pnpm import:sync, cron 12 saatte bir)
# Altay — Eryaz GetProduct (sunucu IP'si Eryaz'da whitelist'te olmalı)
ERYAZ_COMPANY_KEY=D6956DFF
ERYAZ_USERNAME=altay_atakan
ERYAZ_PASSWORD=
# ALTAY_XML_PATH=/home/.../guntaneticaret/products.xml
# Başbuğ — api.basbug.com.tr (marj net fiyat nf üzerine, kur Başbuğ'un kendi kuru)
BASBUG_USERNAME=
BASBUG_PASSWORD=
BASBUG_CLIENT_ID=materialApi
BASBUG_CLIENT_SECRET=
BASBUG_DEPO=MRK
# Başbuğ stok bilgisini yok say (hepsi stokta görünür): BASBUG_USE_STOCK=0
# BASBUG_JSON_PATH=/home/.../guntaneticaret/data/basbug/all_products.json
# Kuru elle sabitlemek için (verilirse Başbuğ/TCMB kuru yerine kullanılır):
# BASBUG_EUR_TRY=56.3
# BASBUG_USD_TRY=48.4
# Tüm ürünleri (değişmeyenler dahil) yeniden işlemek için: FORCE_FULL_IMPORT=1

# Garanti BBVA sanal POS (3D OOS_PAY). Dördü de dolu değilse ödeme sayfasında kart seçeneği görünmez.
# GARANTI_MODE=TEST iken banka test ortamı kullanılır (gerçek çekim olmaz); canlı için PROD.
GARANTI_MODE=TEST
GARANTI_MERCHANT_ID=
GARANTI_TERMINAL_ID=
GARANTI_PROV_USER_ID=PROVAUT
GARANTI_PROV_PASSWORD=
GARANTI_STORE_KEY=
# GARANTI_COMPANY_NAME=Guntan Oto Yedek Parca
# Taksit: "taksit:vade farkı %" (boşsa sadece tek çekim). Örn: 2:3.5,3:4.9,6:8.9
GARANTI_INSTALLMENTS=
# Taksit için sepet alt sınırı (TL): GARANTI_INSTALLMENT_MIN_AMOUNT=500

# Aras Kargo. Doluysa admin'de "Aras Kargo'ya ver" çıkar; takip cron'u scripts/shipment-sync.sh.
ARAS_MODE=TEST
ARAS_USERNAME=
ARAS_PASSWORD=
ARAS_CUSTOMER_CODE=
# Takip sorgusu için ayrı hesap verildiyse: ARAS_QUERY_USERNAME= / ARAS_QUERY_PASSWORD=
# 1 = gönderici öder, 2 = alıcı öder
ARAS_PAYOR_TYPE=1
# ARAS_SENDER_ADDRESS_ID=
# Canlıda panel: https://guntanotoyedekparca.com/yonetim (ADMIN_BASE_PATH production'da otomatik /yonetim)
